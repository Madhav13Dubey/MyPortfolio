# Copy to .env.local for local overrides. Never commit real secrets - everything
# prefixed VITE_ is bundled into public JavaScript.

# Contact form endpoint (Formspree: https://formspree.io/f/<your-id>).
# Falls back to the legacy Google Apps Script endpoint when empty.
VITE_FORM_ENDPOINT=

# Base path. "/" for Vercel / custom domain, "/MyPortfolio/" for GitHub Pages
# (the deploy workflow sets this automatically).
VITE_BASE=/
