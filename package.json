{
  "name": "madhav-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Madhav Dubey - personal developer portfolio",
  "author": "Madhav Dubey",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "structure:check": "node scripts/check-structure.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "bundle:check": "node scripts/check-assets.mjs --dist",
    "hygiene:check": "node scripts/check-hygiene.mjs",
    "lint:js": "eslint src tests scripts vite.config.js playwright.config.js --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate index.html public/404.html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run structure:check && npm run assets:check && npm run hygiene:check && npm run lint:js && npm run lint:css && npm run lint:html && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "build:ci": "npm run lint && vite build && npm run bundle:check",
    "images:optimize": "node scripts/optimize-images.mjs",
    "commitmsg:check": "commitlint --edit"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.css": [
      "stylelint",
      "prettier --check"
    ],
    "*.{html,json,md,yml}": [
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "stylelint": "^18.1.0",
    "stylelint-config-recommended": "^19.1.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
